# Copy to .env and fill in. NEVER commit .env — this repo is public.

# Anam AI — https://lab.anam.ai
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Firecrawl — https://firecrawl.dev
FIRECRAWL_API_KEY=

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Part B — Evolve service. Every entry below is OPTIONAL: a missing key
# degrades one capability and the service still runs. See INTEGRATION.md.
# ---------------------------------------------------------------------------

# Model split (plan §9: separate supervisor and worker budgets).
EVOLVE_SUPERVISOR_MODEL=gpt-5.6-luna
EVOLVE_SPECIALIST_MODEL=gpt-5.6-terra

# Independent acoustic judge and second decoder. Both run on OPENAI_API_KEY.
EVOLVE_JUDGE_MODEL=gpt-audio-1.5
EVOLVE_STT_MODEL=gpt-4o-transcribe

# Local Kokoro worker. Until this is set, candidates render through a simulated
# G2P and the judge compares phoneme strings rather than assessing real audio.
KOKORO_URL=

# Optional alternatives to the OpenAI path.
GROQ_API_KEY=
GEMINI_API_KEY=

# Evolve's OWN database — must be a separate Supabase project from the product
# database above (plan §15: a separate data namespace).
EVOLVE_SUPABASE_URL=
EVOLVE_SUPABASE_ANON_KEY=
EVOLVE_SUPABASE_SERVICE_ROLE_KEY=

# External app records (plan §11). Absent = those records are simply not written.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=ruhana-evolve
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
